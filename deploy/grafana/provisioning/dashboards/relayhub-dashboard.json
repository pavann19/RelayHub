  "liveNow": false,
  "panels": [
    {
      "title": "Gateway Ingestion Throughput (req/s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(relayhub_gateway_requests_total[1m])) by (status)",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "title": "Rate Limit Exceeded (429s)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(relayhub_ratelimit_exceeded_total[1m])) by (tenant)",
          "legendFormat": "Tenant {{tenant}}"
        }
      ]
    },
    {
      "title": "Webhook Delivery Outcomes (Success / Retry / DLQ)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(rate(relayhub_webhook_deliveries_total[1m])) by (outcome)",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "title": "Webhook Roundtrip Latency (p95, p99)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(relayhub_webhook_delivery_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95 latency"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(relayhub_webhook_delivery_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99 latency"
        }
      ]
    }
  ],
  "refresh": "5s",
